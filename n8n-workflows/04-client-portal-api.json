      "typeVersion": 2,
      "position": [672, 1152],
      "parameters": { "mode": "runOnceForAllItems", "jsCode": "const PLANS = {\n  inbound_launch:    { amountZAR: 999,  included: 0 },\n  inbound_growth:    { amountZAR: 1499, included: 300 },\n  inbound_business:  { amountZAR: 2499, included: 750 },\n  outbound_launch:   { amountZAR: 999,  included: 300 },\n  outbound_growth:   { amountZAR: 1999, included: 600 },\n  outbound_business: { amountZAR: 2999, included: 1000 },\n  chat_launch:       { amountZAR: 999,  included: 0 },\n  chat_growth:       { amountZAR: 1999, included: 0 },\n  chat_business:     { amountZAR: 2999, included: 0 },\n};\nconst first = $input.first();\nconst hasDeal = first && first.json && first.json.id != null;\nif (!hasDeal) { return [{ json: { account: {} } }]; }\nconst deal = first.json.properties || {};\nconst product = deal.digibi_product || '';\nconst tier = deal.digibi_tier || '';\nconst plan = PLANS[product + '_' + tier] || { amountZAR: 0, included: 0 };\nconst used = Number(deal.digibi_period_minutes_used) || 0;\nconst included = plan.included || 0;\nconst account = {\n  dealname: deal.dealname || '',\n  email: deal.digibi_contact_email || '',\n  minutes_used: used,\n  included_minutes: included,\n  minutes_remaining: Math.max(0, included - used),\n  period_started_at: deal.digibi_period_started_at ? Number(deal.digibi_period_started_at) : null,\n  overage_rate_zar: (Number(deal.digibi_overage_rate_cents) || 0) / 100,\n  product: product,\n  tier: tier,\n  plan_amount_zar: plan.amountZAR || 0,\n  balance_due_zar: (Number(deal.digibi_balance_due_cents) || 0) / 100,\n  card_saved: !!deal.digibi_yoco_customer_code,\n  onboarding_status: deal.digibi_onboarding_status || '',\n};\nreturn [{ json: { account } }];" }
