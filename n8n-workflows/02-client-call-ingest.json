            { "id": "disconnection_reason", "displayName": "disconnection_reason", "type": "string", "canBeUsedToMatch": false, "display": true, "required": false, "defaultMatch": false },
            { "id": "transcript", "displayName": "transcript", "type": "string", "canBeUsedToMatch": false, "display": true, "required": false, "defaultMatch": false }
          ]
        },
        "options": {}
      },
      "id": "108f01f0-de8b-4e6e-a5ca-68226de5393b",
      "name": "Store Call",
