            "caller_number": "={{ $json.caller_number }}",
            "disconnection_reason": "={{ $json.disconnection_reason }}",
            "transcript": "={{ $json.transcript }}"
          },
          "schema": [
            { "id": "client_key", "displayName": "client_key", "type": "string", "canBeUsedToMatch": false, "display": true, "required": false, "defaultMatch": false },
            { "id": "call_id", "displayName": "call_id", "type": "string", "canBeUsedToMatch": false, "display": true, "required": false, "defaultMatch": false },
            { "id": "ts", "displayName": "ts", "type": "date", "canBeUsedToMatch": false, "display": true, "required": false, "defaultMatch": false },
